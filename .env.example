# Server-only secrets. Configure these in Render Environment, never in VITE_* variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional second provider. The adapter is registered only when both values are present.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_PROVIDER_ID=openai-compatible
OPENAI_COMPAT_DISPLAY_NAME=OpenAI-compatible provider

# One-time bootstrap secret: use at least 32 random characters.
# After the first active admin is created, the bootstrap endpoint closes.
AFG_ADMIN_BOOTSTRAP_TOKEN=

# Optional trusted browser origins, comma-separated. Same-origin deployment needs no value.
APP_ORIGIN=

# PostgreSQL is required for account sessions, admin controls, provider settings and user preferences.
# Apply database/schema.sql manually before enabling those features.
DATABASE_URL=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5

# Conservative token budget used when a provider does not publish context-window metadata.
AFG_UNKNOWN_CONTEXT_BUDGET=8192

# Optional public API base for a native APK; leave blank for same-origin web.
# Never put provider secrets in VITE_* variables.
VITE_API_BASE_URL=

# Render supplies PORT automatically.
