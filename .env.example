# Server-only secrets. Configure these in Render Environment, never in VITE_* variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional trusted browser origins, comma-separated. Same-origin deployment needs no value.
APP_ORIGIN=

# PostgreSQL is currently a foundation only; persistence/auth endpoints are not enabled.
DATABASE_URL=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5

# Render supplies PORT automatically.
