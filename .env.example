# Server-only secrets. Configure these in Render Environment, never in VITE_* variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional generic OpenAI-compatible provider.
# No cloud provider is selected implicitly: configure a supported provider explicitly.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_PROVIDER_ID=openai-compatible
OPENAI_COMPAT_DISPLAY_NAME=OpenAI-compatible provider

# Secured AFG AI GPT-OSS proxy. Keep the bearer key server-side; never use VITE_ prefixes.
GPTOSS_BASE_URL=
GPTOSS_API_KEY=
GPTOSS_PROVIDER_ID=gpt-oss-proxy
GPTOSS_DISPLAY_NAME=GPT-OSS Proxy

# One-time bootstrap secret: use at least 32 random characters.
# After the first active admin is created, the bootstrap endpoint closes.
AFG_ADMIN_BOOTSTRAP_TOKEN=

# Optional trusted browser origins, comma-separated. Same-origin deployment needs no value.
# In production this is also the canonical HTTPS origin used for OAuth redirects.
APP_ORIGIN=

# Optional Google OAuth. Create credentials in Google Cloud Console.
# Authorized redirect URI: https://YOUR_APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional email verification, password reset and security notification delivery.
# Obtain the API key from Resend and use a verified sender address for EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=
# Optional dedicated pepper for hashing email verification/reset codes.
AFG_EMAIL_CODE_PEPPER=

# Optional web research provider; presence of this key enables the research capability flag.
TAVILY_API_KEY=

# PostgreSQL is required for account sessions, conversations, admin controls, provider settings, preferences and distributed rate limits.
# For new installations run: npm run db:migrate (see database/MIGRATIONS.md).
DATABASE_URL=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5

# Conservative token budget used when a provider does not publish context-window metadata.
AFG_UNKNOWN_CONTEXT_BUDGET=8192

# Optional public API base for a native APK; leave blank for same-origin web.
# Never put provider secrets in VITE_* variables.
VITE_API_BASE_URL=

# Render supplies PORT automatically.

# Absolute private persistent-storage path; never place uploads under public/ or dist/.
AFG_UPLOAD_QUARANTINE_DIR=

# Terminal foundation. Shell execution is permanently unavailable until a real isolated sandbox is deployed.
TERMINAL_EXEC_ENABLED=false
TERMINAL_SANDBOX=
TERMINAL_ALLOWLIST=ls,pwd,cat,head,tail,wc,grep,find,echo,date,afg
TERMINAL_TIMEOUT_SECONDS=5
TERMINAL_MAX_OUTPUT_BYTES=262144
CLI_TOKEN_TTL_DAYS=30
CLI_RATE_LIMIT_PER_HOUR=120

# Offline Learning remains disabled until signed pack hosting and a local runtime are implemented.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_PULL_ON_INSTALL=false
PACK_SIGNING_PUBKEY=
PACK_MIRROR_URL=
OFFLINE_SYNC_DEFAULT=false
