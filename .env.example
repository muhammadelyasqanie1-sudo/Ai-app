# Provider credential vault (AES-256-GCM); generate 32 random bytes and encode as base64.
# Keep this stable and server-only. Never use a VITE_ prefix.
PROVIDER_KEYS_MASTER_KEY=

# Server-only secrets. Configure these in Render Environment, never in VITE_* variables.

# Optional self-hosted 9Router gateway. Configure its public HTTPS service URL (with or without /v1).
# NINEROUTER_API_KEY is required only if 9Router dashboard setting requireApiKey is enabled.
# 9Router is a separate service and needs its own persistent storage and provider/account setup.
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=
# Optional exact web-search model ID from GET /v1/models/web; otherwise AFG AI selects an active combo automatically.
NINEROUTER_WEB_SEARCH_MODEL=
# Optional exact web-fetch model ID from GET /v1/models/web; otherwise AFG AI selects an active fetch combo automatically.
NINEROUTER_WEB_FETCH_MODEL=

# APInex OpenAI-compatible gateway. Store a JSON array of keys in Railway Secrets.
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_API_KEYS=[]

# One-time bootstrap secret: use at least 32 random characters.
# After the first active admin is created, the bootstrap endpoint closes.
AFG_ADMIN_BOOTSTRAP_TOKEN=

# Optional trusted browser origins, comma-separated. Same-origin deployment needs no value.
# In production this is also the canonical HTTPS origin used for OAuth redirects.
APP_ORIGIN=

# Optional Google OAuth. Create credentials in Google Cloud Console.
# Authorized redirect URI: https://YOUR_APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional email verification, password reset and security notification delivery.
# Obtain the API key from Resend and use a verified sender address for EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=
# Optional dedicated pepper for hashing email verification/reset codes.
AFG_EMAIL_CODE_PEPPER=

# Optional web research provider; presence of this key enables the research capability flag.
TAVILY_API_KEY=

# PostgreSQL is required for account sessions, conversations, admin controls, provider settings, preferences and distributed rate limits.
# Use a PostgreSQL connection string (not a Supabase anon/publishable API key). Supabase hosts enable TLS automatically when DATABASE_SSL is unset.
# For new installations run: npm run db:migrate (see database/MIGRATIONS.md).
DATABASE_URL=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5

# Conservative token budget used when a provider does not publish context-window metadata.
AFG_UNKNOWN_CONTEXT_BUDGET=8192

# Optional public API base for a native APK; leave blank for same-origin web.
# Never put provider secrets in VITE_* variables.
VITE_API_BASE_URL=

# Render supplies PORT automatically.

# Absolute path on a private persistent disk (e.g. /var/data/afg-uploads on Render).
# Required for the private file library. Uploads remain quarantined until a scanner is configured.
# Never place uploads under the repository, public/ or dist/.
AFG_UPLOAD_QUARANTINE_DIR=

# OpenJarvis private sidecar. Configure the same high-entropy OPENJARVIS_API_KEY on both services.
# OPENJARVIS_INTERNAL_URL must be the private internal URL of the separate OpenJarvis service.
# Never use VITE_ prefixes for either variable.
OPENJARVIS_INTERNAL_URL=
OPENJARVIS_API_KEY=

# Terminal foundation. Shell execution is permanently unavailable until a real isolated sandbox is deployed.
TERMINAL_EXEC_ENABLED=false
TERMINAL_SANDBOX=
TERMINAL_ALLOWLIST=ls,pwd,cat,head,tail,wc,grep,find,echo,date,afg
TERMINAL_TIMEOUT_SECONDS=5
TERMINAL_MAX_OUTPUT_BYTES=262144
CLI_TOKEN_TTL_DAYS=30
CLI_RATE_LIMIT_PER_HOUR=120

# Offline Learning remains disabled until signed pack hosting and a local runtime are implemented.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_PULL_ON_INSTALL=false
PACK_SIGNING_PUBKEY=
PACK_MIRROR_URL=
OFFLINE_SYNC_DEFAULT=false

# Connections & Integrations: generate 32 random bytes and encode as base64.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required before saving integration credentials. Keep server-side; never use VITE_ prefix.
AFG_INTEGRATION_ENCRYPTION_KEY=

# Optional isolated MCP worker endpoint. MCP stays disabled unless a hardened sandbox adapter is deployed.
AFG_MCP_SANDBOX_URL=
AFG_MCP_SANDBOX_TOKEN=

# Optional GitHub OAuth App for individual user account linking.
# Callback URL: https://YOUR_APP_ORIGIN/api/integrations/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Automatic chat routing: prefer a verified local Ollama model when available; otherwise use the configured online routing policy.
AFG_AI_PREFER_OFFLINE=false
# Optional comma-separated provider preference order for otherwise equivalent verified models.
AFG_AI_PROVIDER_ORDER=ollama,9router,cloudflare,openai-compatible

# Agent worker bounds. Concurrency supports 1-2; keep DATABASE_POOL_MAX >= concurrency + 2.
# Per-step timeout supports 1000-120000 ms. Invalid values use these defaults.
AFG_AGENT_CONCURRENCY=2
AFG_AGENT_TIMEOUT_MS=60000

# Existing optional remote browser adapter. Obtain from Browserbase; keep server-side.
BROWSERBASE_API_KEY=

# Self-learning knowledge engine (migration 0051).
# Optional OpenAI-compatible embeddings. Leave any value empty to keep pure PostgreSQL
# full-text retrieval; AFG AI never generates fake local embeddings.
AFG_KNOWLEDGE_EMBEDDING_BASE_URL=
AFG_KNOWLEDGE_EMBEDDING_API_KEY=
AFG_KNOWLEDGE_EMBEDDING_MODEL=
# Bounded stale-source refresh worker (`npm run knowledge:refresh`). A host scheduler
# must invoke it; the API server does not start it automatically.
AFG_KNOWLEDGE_REFRESH_MAX=5

# Unified Media Studio (migration 0050; reuses the agent queue and private file directory).
# Absolute ClamAV executable; maintain its production signatures with freshclam.
AFG_CLAMSCAN_PATH=
# Optional absolute signature database path; empty uses ClamAV defaults. Never use test signatures in production.
AFG_CLAMSCAN_DATABASE=
# Optional ffprobe executable for local MP4/WebM metadata; defaults to /usr/bin/ffprobe.
AFG_FFPROBE_PATH=
# Optional server-side JSON object: exact provider::discovered-model ID -> supported task names.
# Only attest documented compatible endpoints. Empty {} advertises no additional media capabilities.
AFG_MEDIA_TASKS_JSON={}
