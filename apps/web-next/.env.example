# ============================================================
# AFG AI — environment configuration
# ============================================================

# SQLite database (default). For PostgreSQL see DEPLOYMENT-AFG-AI.md.
DATABASE_URL=file:./db/custom.db

# Server-only secrets. Generate each as 32 random bytes, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AFG_SESSION_SECRET signs sessions/share tokens; AFG_VAULT_KEY encrypts stored provider keys (AES-256-GCM).
AFG_SESSION_SECRET=
AFG_VAULT_KEY=

# Development code delivery: when true AND no RESEND_API_KEY, verification/reset
# codes are returned in API responses so flows are testable. Ignored (and warned
# about) in production — dev codes are hard-disabled there.
AFG_ALLOW_DEV_CODES=false

# Production only: creating the first ADMIN account requires the request header
# x-bootstrap-token to match this value timing-safely (min 32 chars). Leave empty
# in non-production, where the first account is promoted automatically.
AFG_ADMIN_BOOTSTRAP_TOKEN=

# Set to 1 only when the app runs behind a trusted reverse proxy; then
# x-forwarded-for / x-real-ip are honored for rate limiting and audit logs.
# Without it, the raw socket IP is used (headers are never trusted).
AFG_TRUST_PROXY=

# Escape hatch for self-hosted local providers (e.g. Ollama on 127.0.0.1):
# set to 1 to allow private/loopback provider base URLs in the admin panel.
# Default is 0 — provider base URLs must resolve to public addresses.
AFG_ALLOW_LOCAL_PROVIDER_URLS=0

# Canonical HTTPS origin (production; used for OAuth redirects and Secure cookies).
APP_ORIGIN=

# --- Optional providers (all honest-status: unconfigured = shown as unavailable) ---
# 9Router AI Gateway (OpenAI-compatible). API key only if 9Router requireApiKey is enabled.
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=

# Ollama (native protocol, e.g. http://127.0.0.1:11434)
OLLAMA_BASE_URL=

# Generic OpenAI-compatible provider
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_DISPLAY_NAME=

# --- Optional integrations ---
# Google OAuth: redirect URI https://YOUR_APP_ORIGIN/api/auth/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery via Resend (verification / password reset)
RESEND_API_KEY=
EMAIL_FROM=

# Conservative token budget for models without context metadata
AFG_UNKNOWN_CONTEXT_BUDGET=8192

# Private upload storage directory (content never served publicly; authenticated downloads only)
AFG_UPLOAD_DIR=db/uploads
